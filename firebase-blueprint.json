        "dead_reason": { "type": "string", "maxLength": 120 },
        "dead_remarks": { "type": "string", "maxLength": 2000 },
        "dead_by": { "type": "string", "maxLength": 128 },
        "dead_by_name": { "type": "string", "maxLength": 120 },
        "dead_at": { "type": "string", "maxLength": 50 },
        "import_batch_ref": { "type": "string", "maxLength": 80 },
        "created_date_iso": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "lead_code",
        "customer_name",
        "mobile",
        "lead_source",
        "property_type",
        "property_subtype",
        "transaction_type",
        "localities",
        "stage",
        "is_terminal_stage",
        "created_by",
        "assigned_to",
        "assigned_to_email",
        "assigned_to_name",
