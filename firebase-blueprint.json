        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "full_name", "mobile", "designation", "role", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "EmployeeDirectoryEntry": {
      "title": "EmployeeDirectoryEntry",
      "description": "Non-PII team member directory entry readable by active team members for lead assignment labels.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "email_key": { "type": "string", "format": "email", "maxLength": 200 },
        "full_name": { "type": "string", "minLength": 1, "maxLength": 120 },
