        "lead_view_preference": { "type": "string", "enum": ["table", "kanban"] },
        "page_size_preference": { "type": "number" },
        "table_columns_preference": { "type": "array" },
        "invite_id": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "email",
        "full_name",
        "mobile",
        "designation",
        "role",
        "status",
        "theme_preference",
        "lead_view_preference",
        "page_size_preference",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmployeeInvite": {
      "title": "EmployeeInvite",
      "description": "Super Admin provisioned employee invitation gated by verified Google email.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "full_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mobile": { "type": "string", "maxLength": 20, "pattern": "^(|[6-9][0-9]{9})$" },
        "designation": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["super_admin", "sales_executive"] },
