    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "Company branding, default table column layout, and sequential SSM lead ID counter.",
      "type": "object",
      "properties": {
        "company_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "short_name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "company_logo": { "type": "string", "maxLength": 400000 },
        "default_table_columns": { "type": "array", "description": "Up to 20 default column keys" },
        "lead_seq": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["company_name", "short_name", "default_table_columns", "lead_seq", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted active Super Admin privilege lookup document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated internal employee profile with PII, role, status, and UI preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "full_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mobile": { "type": "string", "maxLength": 20, "pattern": "^(|[6-9][0-9]{9})$" },
        "designation": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["super_admin", "sales_executive"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "profile_photo": { "type": "string", "maxLength": 300000 },
