        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email_key", "full_name", "designation", "role", "status", "createdAt", "updatedAt"]
    },
    "MasterItem": {
      "title": "MasterItem",
      "description": "Configurable CRM master value (stages, sources, Ahmedabad localities, property types/subtypes, etc.).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": {
          "type": "string",
          "enum": [
            "lead_source",
            "lead_stage",
            "property_type",
            "property_subtype",
            "transaction_type",
            "locality",
            "bhk_config",
            "dead_reason",
            "furnishing_type",
            "possession_pref"
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "parent_value": { "type": "string", "maxLength": 120 },
        "sort_order": { "type": "number" },
        "is_active": { "type": "boolean" },
        "is_terminal": { "type": "boolean" },
        "terminal_outcome": { "type": "string", "enum": ["won", "lost"] },
        "system_key": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "name", "sort_order", "is_active", "is_terminal", "createdAt", "updatedAt"]
    },
